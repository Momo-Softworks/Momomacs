     `(rainbow-delimiters-depth-3-face ((t (:foreground ,r2))))
     `(rainbow-delimiters-depth-4-face ((t (:foreground ,r3))))
     `(rainbow-delimiters-depth-5-face ((t (:foreground ,r0))))
     `(rainbow-delimiters-depth-6-face ((t (:foreground ,r1))))
     `(rainbow-delimiters-depth-7-face ((t (:foreground ,r2))))
