;;; guix-gold-palette.el --- shared face generator for guix-gold  -*- lexical-binding: t; -*-

;; One face spec set, fed a palette plist by guix-gold-theme.el (dark) and
;; guix-gold-light-theme.el (light).  Keeps the two variants from drifting.

(defun guix-gold--faces (p)
  "Return a list of `custom-theme-set-faces' specs from palette plist P."
  (let* ((bg      (plist-get p :bg))
         (bg-soft (plist-get p :bg-soft))
         (bg-hl   (plist-get p :bg-hl))
         (fg      (plist-get p :fg))
         (fg-dim  (plist-get p :fg-dim))
         (cursor  (plist-get p :cursor))
         (comment (plist-get p :comment))
         (keyword (plist-get p :keyword))   ; gold
         (builtin (plist-get p :builtin))   ; ember
         (string  (plist-get p :string))    ; green
         (type    (plist-get p :type))      ; periwinkle
         (quote-c (plist-get p :quote))     ; pink
         (error-c (plist-get p :error))     ; crimson
         (paren   (plist-get p :paren))
         (r0      (plist-get p :r0))
         (r1      (plist-get p :r1))
         (r2      (plist-get p :r2))
         (r3      (plist-get p :r3))
         (add-bg  (plist-get p :add-bg))
         (add-bg2 (plist-get p :add-bg-hi))
         (del-bg  (plist-get p :del-bg))
         (del-bg2 (plist-get p :del-bg-hi))
         (chg-bg  (plist-get p :chg-bg))
         (chg-bg2 (plist-get p :chg-bg-hi))
         (add-fg  (plist-get p :add-fg))
         (del-fg  (plist-get p :del-fg))
         (chg-fg  (plist-get p :chg-fg)))
